# ── OpenAI-compatible endpoint ───────────────────────────────────────────────
# Used by OpenAIToolUseAdapter (TOOL_USE agents) and the web_fetch tool as a
# fallback when the AgentTemplate doesn't set its own base_url/api_key/model.
OPENAI_BASE_URL="https://api.openai.com/v1"
OPENAI_API_KEY="sk-..."
OPENAI_MODEL="gpt-5.5"

# Model used by the web_fetch tool to summarize fetched pages.
# Falls back to OPENAI_MODEL, then "gpt-4o-mini".
# WEB_FETCH_MODEL="gpt-4o-mini"

# ── Persistence ──────────────────────────────────────────────────────────────
# DB_TYPE selects the backend: "mysql" (default) or "mock" (in-memory).
DB_TYPE="mysql"
MYSQL_HOST="127.0.0.1"
MYSQL_PORT="3306"
MYSQL_USER="root"
MYSQL_PASSWORD=""
MYSQL_DATABASE="agentzoo"

# ── Cross-session orchestration ──────────────────────────────────────────────
# Gateway URL the subagent / session_send / list_subagents tools call back into.
# GATEWAY_URL="http://localhost:12598"
# Root dir for fallback scratch worktrees when the parent isn't a git repo.
# Defaults to backend/tmp/sessions.
# AGENTZOO_WORKTREE_ROOT=

# ── Logging ──────────────────────────────────────────────────────────────────
# AGENTZOO_DEBUG=1 enables DEBUG-level logs from all agentzoo.* loggers,
# including subprocess argv, NDJSON lines, tool-call args, and stderr.
# AGENTZOO_LOG_LEVEL overrides the level explicitly (DEBUG/INFO/WARNING/ERROR).
# AGENTZOO_DEBUG=0
# AGENTZOO_LOG_LEVEL=INFO
